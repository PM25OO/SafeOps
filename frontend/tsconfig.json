{
  "compilerOptions": {
    "target": "ES2021",
    "module": "ES2020",
    "moduleResolution": "Node",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "outDir": "dist",
    "rootDir": "src",
    "types": ["chrome", "jest", "node"],
    "lib": ["DOM", "ES2021"]
  },
  "include": ["src"],
  "exclude": ["tests"]
}
